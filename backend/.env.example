PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbam_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Superadmin Seed Credentials
SUPER_ADMIN_EMAIL=admin@cbam.eu
SUPER_ADMIN_PASSWORD=AdminPass123!
SUPER_ADMIN_NAME="Super Administrator"

# SMTP Mailer Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="EU CBAM Admin <no-reply@cbam.eu>"
